# ============================================================
# BriefFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Gemini (Google AI) — OBRIGATÓRIO ---
# Gratuito em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# --- Google Drive ---
# Configure em: https://console.cloud.google.com
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================
# PIPELINE PRINCIPAL
# ============================================================

# Executa sem chamar a API do Gemini (usa arquivos de exemplo em data/examples/)
OFFLINE_MODE=false

# Pula assets que já foram gerados anteriormente
SKIP_EXISTING=true

# Número de tentativas antes de tentar o modelo de fallback
GEN_RETRIES=5

# Pausa (segundos) entre a geração de cada asset de texto
SLEEP_BETWEEN_ASSETS=0.5

# ============================================================
# ETAPA VISUAL (Etapa 3/3 do pipeline)
# ============================================================

# Define se a etapa visual deve ser pulada completamente
# true  → apenas gera os TXTs e o PPTX, sem HTML/PDF/imagens
# false → executa HTML+PDF e imagem de post (padrão)
SKIP_VISUAL_AI=false

# --- Provedor para DOCUMENTOS (emails, folheto, ficha técnica) ---
# weasyprint → Gemini formata HTML + WeasyPrint renderiza PDF local (100% gratuito)
# skip       → não gera HTML nem PDF
VISUAL_AI_PROVIDER_DOCS=weasyprint

# --- Provedor para IMAGENS de posts (Instagram, LinkedIn etc.) ---
# gemini_imagen → Gemini Imagen (gratuito com cota mensal) + fallback automático Pexels
# pexels        → Pexels direto, sempre (100% gratuito, sem IA)
# skip          → não gera imagem
VISUAL_AI_PROVIDER_POSTS=gemini_imagen

# --- Pexels — imagens de stock gratuitas ---
# Usado como fallback de imagens (ou provedor principal se VISUAL_AI_PROVIDER_POSTS=pexels)
# Registro gratuito em 2 minutos: https://www.pexels.com/api
PEXELS_API_KEY=
