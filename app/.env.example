# ============================================================
# BriefFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Gemini (Google AI) — OBRIGATÓRIO ---
# Gratuito em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# --- Google Drive ---
# Configure em: https://console.cloud.google.com
GOOGLE_DRIVE_FOLDER_ID=

# --- Pipeline ---
OFFLINE_MODE=false
SKIP_EXISTING=true
GEN_RETRIES=5
SLEEP_BETWEEN_ASSETS=0.5

# ============================================================
# GERAÇÃO VISUAL — Configurar providers abaixo
# ============================================================

# Controle de providers (opções: nome_do_provider | skip)
VISUAL_AI_PROVIDER_SLIDES=gamma          # gamma | skip
VISUAL_AI_PROVIDER_DESIGN=canva          # canva | skip
VISUAL_AI_PROVIDER_POSTS=gemini_imagen   # gemini_imagen | dalle | pexels | skip

# Pular toda a etapa visual (sobrescreve os providers acima)
SKIP_VISUAL_AI=false

# --- Gamma (Slides Visuais) ---
# GRATUITO: 400 créditos/mês
# Registro: https://gamma.app → Settings → API
GAMMA_API_KEY=

# --- Canva Connect API (E-mails, Folhetos, Ficha Técnica) ---
# GRATUITO com conta Canva
# Registro: https://www.canva.com/developers
CANVA_API_KEY=

# --- OpenAI DALL-E 3 (Posts) ---
# PAGO: ~$0.04 por imagem
# Registro: https://platform.openai.com
OPENAI_API_KEY=

# --- Pexels (Imagens de Stock — FALLBACK GRATUITO) ---
# 100% GRATUITO, sem limite mensal para uso básico
# Registro: https://www.pexels.com/api
PEXELS_API_KEY=
