# ============================================================
# BriefFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Gemini (Google AI) — OBRIGATÓRIO ---
# Gratuito em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# --- Google Drive ---
# Configure em: https://console.cloud.google.com
GOOGLE_DRIVE_FOLDER_ID=

# --- Pipeline ---
OFFLINE_MODE=false
SKIP_EXISTING=true
GEN_RETRIES=5
SLEEP_BETWEEN_ASSETS=0.5

# ============================================================
# GERAÇÃO VISUAL
# ============================================================

# Pular toda a etapa de geração visual
SKIP_VISUAL_AI=false

# Provider para imagens de posts:
#   gemini_imagen  → Gemini Imagen (gratuito, cota mensal) com fallback automático para Pexels
#   pexels         → Pexels direto (100% gratuito, sem geração de IA)
#   skip           → não gera imagem
VISUAL_AI_PROVIDER_POSTS=gemini_imagen

# --- Pexels — imagens de stock gratuitas (fallback de posts) ---
# 100% GRATUITO, sem limite mensal para uso básico
# Registro em 2 minutos: https://www.pexels.com/api
PEXELS_API_KEY=

# ============================================================
# APIs PAGAS / SEM PLANO GRATUITO VIA API (não recomendadas)
# ============================================================
# NOTA: Gamma não possui API pública. Canva API requer Enterprise.
# E-mails, folhetos e fichas são gerados localmente via Gemini + WeasyPrint.
# OPENAI_API_KEY=   # DALL-E 3: ~$0.04/imagem, opcional
