# Endpoint do Ollama (remoto ou local). Prefixo VITE_ é obrigatório no Vite.
# Copie este arquivo para .env e ajuste.
VITE_OLLAMA_API_URL=http://localhost:11434/api/chat

# Modelos (opcional). Defaults: discovery=qwen2.5:7b, execution=qwen3.6:27b
# VITE_OLLAMA_DISCOVERY_MODEL=qwen2.5:7b
# VITE_OLLAMA_EXECUTION_MODEL=qwen3.6:27b

# Supabase (opcional — biblioteca de assets)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
