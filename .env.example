# ─────────────────────────────────────────────
# Agente de Documentação Forlab — .env.example
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais
# ─────────────────────────────────────────────

# ── Google Gemini — LLM principal ───────────────────────────────────
# Chave GRATUITA em: https://aistudio.google.com/app/apikey
# Usada para: geração de todos os textos (ficha, slides, emails, posts...)
GEMINI_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash

# ── Google Drive — Autenticação ─────────────────────────────────────
# Caminho para o credentials.json baixado do Google Cloud Console
# Tipo: OAuth 2.0 Client ID > Aplicativo Desktop
# As MESMAS credenciais são reutilizadas pelo Google TTS (sem chave extra)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Caminho onde o token de acesso será salvo após a 1ª autorização
# O token é renovado automaticamente após expirar
GOOGLE_TOKEN_PATH=credentials/token.json

# ── Google Drive — Pastas ──────────────────────────────────────────
# ID da pasta onde ficam os vídeos/transcrições de reunião
GOOGLE_DRIVE_INPUT_FOLDER_ID=ID_DA_PASTA_DE_ENTRADA

# ID da pasta onde ficam os vídeos de treinamento para transcrição
GOOGLE_DRIVE_VIDEO_FOLDER_ID=ID_DA_PASTA_DE_VIDEOS

# ID da pasta no Drive onde os materiais gerados serão salvos
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=ID_DA_PASTA_DE_SAIDA

# ── Template de Slides ────────────────────────────────────────────
# URL do Google Slides usado como template (exportado automaticamente como .pptx)
SLIDES_TEMPLATE_URL=https://docs.google.com/presentation/d/17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk/edit
# Caminho local onde o template .pptx será salvo após o download
SLIDES_TEMPLATE_PATH=data/template_slides.pptx

# ── Google Cloud Text-to-Speech (Podcast) ────────────────────────
# Usa as MESMAS credenciais OAuth2 do Drive — sem configuração extra.
# IMPORTANTE: Habilite a API "Cloud Text-to-Speech" no Google Cloud Console:
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
#
# Vozes pt-BR disponíveis (Standard = gratuito até 1M chars/mês):
#   pt-BR-Standard-A  (feminino)
#   pt-BR-Standard-B  (masculino)
#   pt-BR-Standard-C  (feminino)
#   pt-BR-Standard-D  (masculino)
# Vozes WaveNet (qualidade superior, 1M chars/mês gratuitos também):
#   pt-BR-Wavenet-A / B / C / D
TTS_LANGUAGE_CODE=pt-BR
TTS_VOICE_NAME=pt-BR-Standard-B
TTS_AUDIO_ENCODING=MP3
TTS_SPEAKING_RATE=0.95
TTS_PITCH=0.0
TTS_MAX_CHARS=4800

# ── Caminhos locais ───────────────────────────────────────────────
# Pasta onde vídeos do Drive são baixados antes da transcrição
VIDEO_DOWNLOAD_DIR=data/videos
# Pasta de saída dos assets gerados
OUTPUT_DIR=data/output
