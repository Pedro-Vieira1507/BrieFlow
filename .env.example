# ================================================================
# BriefFlow - Variaveis de Ambiente
# Configure ao menos UMA chave de provider. O agente usara
# automaticamente o primeiro que estiver disponivel na ordem:
#   1. Gemini -> 2. Claude -> 3. OpenAI
# ================================================================

# --- [1] Google Gemini (GRATUITO) ---
# Gere sua chave em: https://aistudio.google.com/apikey
# Modelos: gemini-2.0-flash (rapido) | gemini-2.5-flash (melhor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- [2] Anthropic Claude ---
# Cadastro ganha creditos gratuitos: https://console.anthropic.com
# ATENCAO: use o nome exato do modelo conforme listado pela Anthropic
# Modelos validos:
#   claude-3-5-haiku-20241022  (rapido e barato - RECOMENDADO)
#   claude-3-5-sonnet-20241022 (mais capaz)
#   claude-3-haiku-20240307    (mais antigo, mais barato)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- [3] OpenAI ---
# Pay-as-you-go, muito barato: https://platform.openai.com/api-keys
# Modelos: gpt-4o-mini (barato) | gpt-4o (mais capaz)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limite de tokens por resposta ---
# 1200 = padrao equilibrado
# 2000 = para materiais mais completos
MAX_TOKENS=1200
TEMPERATURE=0.6

# --- Pasta de saida dos materiais ---
OUTPUT_DIR=data/output

# --- MCP: Servidor Filesystem (opcional) ---
# Permite ao agente ler arquivos locais diretamente na conversa.
# Requer Node.js instalado: https://nodejs.org
# Defina o caminho da pasta que o agente pode acessar:
# MCP_FILESYSTEM_PATH=C:\Users\Voce\Documents\BriefFlow\data
