# BrieFlow — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores

# URL interna do Ollama (não exposta publicamente)
OLLAMA_URL=http://127.0.0.1:11434

# Modelo padrão — recomendado para 24GB RAM
OLLAMA_MODEL=qwen2.5:14b

# Porta do servidor Node/Bun
PORT=3000

# (Opcional) Google Custom Search — para imagens de produtos de maior qualidade
# Sem isto, o sistema usa DuckDuckGo/Bing automaticamente (sem API Key)
# GOOGLE_SEARCH_API_KEY=sua_chave_aqui
# GOOGLE_SEARCH_CX=seu_cx_aqui
