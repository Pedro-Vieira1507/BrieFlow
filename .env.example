# BrieFlow — variáveis de ambiente (copie para .env e preencha)
#
# IMPORTANTE: nunca commite o .env com valores reais.
# As chaves de API de LLM (OmniRoute, Ollama) devem ficar APENAS nos
# secrets do Supabase Edge Functions — não aqui.

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NÃO coloque aqui:
# VITE_OMNIROUTE_API_KEY  <- vive em Supabase Edge Function secrets como OMNIROUTE_API_KEY
# VITE_OLLAMA_API_URL     <- vive em Supabase Edge Function secrets como OLLAMA_API_URL
# VITE_OLLAMA_*           <- idem
