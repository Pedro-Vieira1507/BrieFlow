# ─────────────────────────────────────────────
# Agente de Documentação Forlab — .env.example
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais
# ─────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────
# Usada para: LLM (gpt-4o), Whisper (transcrição), TTS (podcast)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# ── Google Gemini ─────────────────────────────
# Usada para: geração do content brief (content_brief.py)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── Google Drive — Pastas ─────────────────────
# ID da pasta onde ficam os vídeos/transcrições de reunião
GOOGLE_DRIVE_INPUT_FOLDER_ID=ID_DA_PASTA_DE_ENTRADA

# ID da pasta onde ficam os vídeos de treinamento para transcrição
# (monitorada por build_brief_from_drive em content_brief.py)
GOOGLE_DRIVE_VIDEO_FOLDER_ID=ID_DA_PASTA_DE_VIDEOS

# ID da pasta no Drive onde os materiais gerados serão salvos
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=ID_DA_PASTA_DE_SAIDA

# ── Template de Slides ────────────────────────
# URL do Google Slides usado como template (exportado automaticamente como .pptx)
SLIDES_TEMPLATE_URL=https://docs.google.com/presentation/d/17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk/edit
# Caminho local onde o template .pptx será salvo após o download
SLIDES_TEMPLATE_PATH=data/template_slides.pptx

# ── Text-to-Speech (Podcast) ──────────────────
# Vozes disponíveis: alloy | echo | fable | nova | onyx | shimmer
TTS_VOICE=nova
TTS_MODEL=tts-1-hd

# ── Caminhos locais ───────────────────────────
# Pasta onde vídeos do Drive são baixados antes da transcrição
VIDEO_DOWNLOAD_DIR=data/videos

# ── Credenciais Google Cloud ──────────────────
# Caminho para o JSON de service account ou OAuth2 credentials
GOOGLE_CREDENTIALS_PATH=credentials.json
