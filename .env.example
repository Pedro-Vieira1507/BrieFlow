# ─────────────────────────────────────────────
# Agente de Documentação Forlab — .env.example
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais
# ─────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# Google Drive — Pastas
GOOGLE_DRIVE_INPUT_FOLDER_ID=ID_DA_PASTA_DE_ENTRADA
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=ID_DA_PASTA_DE_SAIDA

# Template de Slides (Google Slides → exportado como .pptx)
SLIDES_TEMPLATE_URL=https://docs.google.com/presentation/d/17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk/edit
SLIDES_TEMPLATE_PATH=data/template_slides.pptx

# Text-to-Speech (OpenAI TTS)
# Vozes disponíveis: alloy | echo | fable | nova | onyx | shimmer
TTS_VOICE=nova
TTS_MODEL=tts-1-hd

# Credenciais Google Cloud (caminho para o JSON de service account ou OAuth)
GOOGLE_CREDENTIALS_PATH=credentials.json
