# ================================================================
# BriefFlow - Variaveis de Ambiente
# ================================================================
# ORDEM DE FALLBACK: Ollama -> Gemini -> Claude -> OpenAI
# Configure ao menos UMA opcao. Ollama e 100% gratuito e local.
# ================================================================

# --- [0] Ollama (LOCAL - 100% GRATUITO, sem API key) ---
# Instalacao: https://ollama.com
# Apos instalar, execute no terminal:
#   ollama pull llama3          (recomendado, 4.7GB)
#   ollama pull mistral         (alternativa, 4.1GB)
#   ollama pull gemma3          (alternativa Google, 5.1GB)
#   ollama pull phi3            (leve, 2.3GB - bom para PCs fracos)
#   ollama pull deepseek-r1     (raciocinio avancado)
# Depois defina abaixo o modelo baixado:
OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434  # altere se Ollama rodar em outro host

# --- [1] Google Gemini (GRATUITO com limite) ---
# Gere sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- [2] Anthropic Claude ---
# Cadastro ganha creditos iniciais: https://console.anthropic.com
# Modelos validos:
#   claude-3-5-haiku-20241022  (rapido e barato - RECOMENDADO)
#   claude-3-5-sonnet-20241022 (mais capaz)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- [3] OpenAI ---
# Pay-as-you-go: https://platform.openai.com/api-keys
# Modelos: gpt-4o-mini (barato) | gpt-4o (mais capaz)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Configuracoes gerais ---
MAX_TOKENS=1200
TEMPERATURE=0.6
OUTPUT_DIR=data/output

# --- MCP: Servidor Filesystem (opcional) ---
# Permite ao agente ler arquivos locais. Requer Node.js: https://nodejs.org
# MCP_FILESYSTEM_PATH=C:\Users\Voce\Documents\BriefFlow\data
