# =============================================================
# BriefFlow — Variaveis de Ambiente
# =============================================================

# --- Caminhos ---
OUTPUT_DIR=data/output

# --- Modelo (GRATUITO no Amazon Bedrock) ---
# amazon.titan-text-lite-v1  -> gratuito, leve, bom para textos estruturados
# amazon.titan-text-express-v1 -> gratuito, mais capaz
# Troque por claude-3-haiku se quiser mais qualidade (tem custo baixo)
BEDROCK_MODEL_ID=amazon.titan-text-lite-v1
AWS_DEFAULT_REGION=us-east-1

# --- Limite de tokens (controle de custos) ---
# 800 = conservador (textos medios)
# 1500 = para materiais mais completos
# 4096 = maximo do Titan Lite
MAX_TOKENS=800
TEMPERATURE=0.6

# --- Credenciais AWS (configure via 'aws configure' ou preencha aqui) ---
# AWS_ACCESS_KEY_ID=sua_chave
# AWS_SECRET_ACCESS_KEY=sua_chave_secreta
