# ── Google Drive ──────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=SEU_FOLDER_ID_AQUI

# ID do arquivo de template PPTX no Google Drive
# Exemplo: https://docs.google.com/presentation/d/17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk/edit
# → ID = 17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk
SLIDES_TEMPLATE_DRIVE_FILE_ID=17e2hu5n3pZMNqy9J3BMO3-BylpSIAsJk

# Alternativa: caminho local para o template (se não usar Drive)
# SLIDES_TEMPLATE_PATH=data/template_slides.pptx

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=openai           # openai | perplexity | gemini
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar-pro

# GOOGLE_GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-pro

# ── Text-to-Speech (podcast MP3) ──────────────────────────────
TTS_VOICE=alloy               # alloy | echo | fable | onyx | nova | shimmer
TTS_MODEL=tts-1               # tts-1 | tts-1-hd (maior qualidade)
TTS_SPEED=1.0                 # 0.25 – 4.0
