# ================================================================
# BriefFlow - Variaveis de Ambiente
# Configure ao menos UMA chave de provider. O agente usara
# automaticamente o primeiro que estiver disponivel na ordem:
#   1. Gemini -> 2. Claude -> 3. OpenAI
# ================================================================

# --- [1] Google Gemini (GRATUITO) ---
# Gere sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- [2] Anthropic Claude ---
# Cadastro ganha creditos gratuitos: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- [3] OpenAI ---
# Pay-as-you-go, muito barato: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limite de tokens por resposta ---
# 1200 = padrao equilibrado
# 2000 = para materiais mais completos
MAX_TOKENS=1200
TEMPERATURE=0.6

# --- Pasta de saida dos materiais ---
OUTPUT_DIR=data/output
