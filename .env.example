# Browser-safe public configuration.
# The VITE_ prefix is mandatory: Vite exposes only explicitly prefixed values
# to browser code. Do not rename these keys or place provider secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the current publishable key (sb_publishable_...). The legacy anon key
# remains accepted by the app only as a temporary migration fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_SUPABASE_ANON_KEY

# Public HTTPS pages required before enabling self-service sign-up.
VITE_TERMS_URL=https://app.example.com/termos
VITE_PRIVACY_URL=https://app.example.com/privacidade
VITE_SUPPORT_URL=https://app.example.com/suporte
VITE_LEGAL_VERSION=2026-09-16
