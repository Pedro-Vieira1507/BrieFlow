=== RETORNO OBRIGATÓRIO (JSON ESTRITO) ===
{
  "chat": "Confirmação breve de que a peça foi gerada. Máx 2 frases.",
  "builder": {
    "type": "campaign",
    "campaignAssets": [
       ${
         targetAsset === "banner"
           ? `{ "id": "banner-1", "type": "banner", "status": "draft", "content": { "type": "banner", "brandName": "...", "title": "...", "subtitle": "...", "cta": "...", "imagePrompt": "..." } }`
           : ""
       }
