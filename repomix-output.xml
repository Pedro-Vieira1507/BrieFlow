         targetAsset === "email"
           ? `{ "id": "email-1", "type": "email", "status": "draft", "content": { "type": "email", "brandName": "...", "preheader": "...", "emailHeroImagePrompt": "...", "title": "...", "subtitle": "...", "body": "...", "cta": "...", "footerText": "..." } }`
           : ""
