# Copy this file to supabase/.env.production, fill the values, and never commit it.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.

ENVIRONMENT=production
APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com,https://your-current-tunnel.trycloudflare.com

# Configure at least one AI provider.
GROQ_API_KEY=
GROQ_DISCOVERY_MODEL=
GROQ_PRIMARY_MODEL=
GROQ_FIRST_FALLBACK_MODEL=
GROQ_SECOND_FALLBACK_MODEL=

GEMINI_API_KEY=
GEMINI_DISCOVERY_MODEL=
GEMINI_CONTENT_MODEL=

OMNIROUTE_API_KEY=
OMNIROUTE_API_URL=
OMNIROUTE_MODEL=
OMNIROUTE_DISCOVERY_MODEL=
OMNIROUTE_CONTENT_MODEL=

OLLAMA_API_URL=
OLLAMA_MODEL=
OLLAMA_DISCOVERY_MODEL=
OLLAMA_CONTENT_MODEL=

# Optional image search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
