# Copy this file to supabase/.env.production, fill the values, and never commit it.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.

ENVIRONMENT=production
APP_URL=https://app.example.com
# Comma-separated exact origins. Wildcards are intentionally unsupported.
ALLOWED_ORIGINS=https://app.example.com

# Configure at least one AI provider.
GROQ_API_KEY=
GROQ_DISCOVERY_MODEL=
GROQ_PRIMARY_MODEL=
GROQ_FIRST_FALLBACK_MODEL=
GROQ_SECOND_FALLBACK_MODEL=

GEMINI_API_KEY=
GEMINI_DISCOVERY_MODEL=
GEMINI_CONTENT_MODEL=
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_PODCAST_MODEL=gemini-3.1-flash-tts-preview
GEMINI_PODCAST_VOICE=Kore

OMNIROUTE_API_KEY=
OMNIROUTE_API_URL=
OMNIROUTE_MODEL=
OMNIROUTE_DISCOVERY_MODEL=
OMNIROUTE_CONTENT_MODEL=

OLLAMA_API_URL=
OLLAMA_MODEL=
OLLAMA_DISCOVERY_MODEL=
OLLAMA_CONTENT_MODEL=

# Optional audiovisual fallback if Gemini media is unavailable.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_PODCAST_MODEL=eleven_multilingual_v2
RUNWAY_PODCAST_VOICE=Maya

# Optional: independent HMAC key used to bind render tasks to authenticated users.
MEDIA_RENDER_SIGNING_SECRET=

# Optional image search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
