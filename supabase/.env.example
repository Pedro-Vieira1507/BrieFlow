# Edge Function secrets (configure with `supabase secrets set --env-file ...`).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase in production.
ENVIRONMENT=production
APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com

# At least one AI provider must be configured. Models are deployment choices.
OMNIROUTE_API_KEY=
OMNIROUTE_API_URL=https://gateway.example.com/v1/chat/completions
OMNIROUTE_DISCOVERY_MODEL=
OMNIROUTE_CONTENT_MODEL=

GROQ_API_KEY=
GROQ_DISCOVERY_MODEL=
GROQ_PRIMARY_MODEL=
GROQ_FIRST_FALLBACK_MODEL=
GROQ_SECOND_FALLBACK_MODEL=

GEMINI_API_KEY=
GEMINI_DISCOVERY_MODEL=
GEMINI_CONTENT_MODEL=

OLLAMA_API_URL=
OLLAMA_DISCOVERY_MODEL=
OLLAMA_CONTENT_MODEL=

# Google Programmable Search (server-side image search).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Stripe billing and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
